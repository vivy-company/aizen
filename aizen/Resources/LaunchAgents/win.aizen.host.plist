<plist version="1.0">
<dict>
    <key>Label</key>
    <string>win.aizen.host</string>
    <key>BundleProgram</key>
    <string>Contents/Resources/cli/aizen-cli</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>AIZEN_HOST_SERVICE</key>
        <string>1</string>
